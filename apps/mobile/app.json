{
  "expo": {
    "name": "EchoGuide",
    "slug": "echoguide-mobile",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#080C14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080C14"
      },
      "package": "com.echoguide.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "BIND_ACCESSIBILITY_SERVICE",
        "SYSTEM_ALERT_WINDOW",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow EchoGuide to capture voice commands for accessibility automation."
        }
      ],
      "expo-status-bar",
      "expo-router"
    ]
  }
}
