{
  "name": "@echoguide/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/app/server.js",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/app/server.js",
    "start:worker": "node dist/app/worker.js",
    "smoke": "tsx src/app/smoke.ts",
    "test": "node --import tsx --test --test-timeout=60000 \"src/**/*.test.ts\"",
    "test:unit": "node --import tsx --test --test-timeout=30000 \"src/modules/**/*.test.ts\" \"src/shared/**/*.test.ts\" \"src/test/golden/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-timeout=60000 \"src/test/integration/*.test.ts\"",
    "test:golden:live": "GOLDEN_AUDIO_LIVE=1 node --import tsx --test src/test/golden/golden-live.test.ts",
    "test:infra:up": "docker compose -f ../../docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f ../../docker-compose.test.yml down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/shared/database/migrate.js",
    "db:migrate:dev": "tsx src/shared/database/migrate.ts",
    "db:rollback": "node dist/shared/database/rollback.js",
    "db:rollback:dev": "tsx src/shared/database/rollback.ts",
    "admin": "node dist/modules/admin/admin.cli.js"
  },
  "dependencies": {
    "@echoguide/openapi": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.11.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
