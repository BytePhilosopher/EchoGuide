# EchoGuide API configuration.
# Copy to .env for local development. Every variable here is read by src/shared/config.ts, which
# validates them at startup and refuses to start if a required one is missing or invalid.
# Never commit real secrets. Values below are local-development placeholders.

# ─── Application ────────────────────────────────────────────────────────────────
# development | test | production. Production enforces the stricter rules marked [prod].
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# How many reverse proxies to trust for the client IP (rate limiting). false = none, 1 = one hop,
# or an Express trust-proxy list such as "loopback, 10.0.0.0/8". [prod] "true" is refused: it
# would let any client spoof X-Forwarded-For.
TRUST_PROXY=false

# ─── Database (required) ────────────────────────────────────────────────────────
# Postgres is the source of truth. Matches docker-compose.yml.
DATABASE_URL=postgres://echoguide_user:echoguide_password@localhost:5432/echoguide_db
DATABASE_POOL_MAX=10

# ─── Redis (required) ───────────────────────────────────────────────────────────
# Rate limits, idempotency records, the telemetry buffer and the job queue. Never authoritative.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=echoguide:

# ─── Addis AI ───────────────────────────────────────────────────────────────────
# [prod] required. Only the backend holds this key; the phone never does.
ADDIS_AI_API_KEY=
ADDIS_AI_BASE_URL=https://api.addisassistant.com
# Hard timeouts from docs/architecture/failure.
ADDIS_TRANSCRIBE_TIMEOUT_MS=8000
ADDIS_PLAN_TIMEOUT_MS=6000
# Circuit breaker: open after N consecutive failures, half-open (one trial) after the reset period.
ADDIS_BREAKER_FAILURE_THRESHOLD=5
ADDIS_BREAKER_RESET_MS=30000
# Confidence gate thresholds (docs/architecture/command-pipeline).
ADDIS_CONFIDENCE_FLOOR=0.6
ADDIS_AVG_LOGPROB_FLOOR=-1.0
ADDIS_NO_SPEECH_PROB_MAX=0.6
ADDIS_COMPRESSION_RATIO_MAX=2.4
# What to do when the transcriber returns no confidence score:
#   confirm  (default) plan, but require spoken confirmation before anything executes
#   reprompt ask the user to repeat
ADDIS_UNAVAILABLE_CONFIDENCE_POLICY=confirm
# Name of the speech-to-text request field that takes vocabulary bias terms. The vendor's field is
# not documented in this repository, so terms are not sent unless this is set after confirming it.
ADDIS_STT_VOCABULARY_FIELD=

# ─── Authentication (required) ──────────────────────────────────────────────────
# Key for hashing session tokens at rest. At least 32 characters. Generate one with:
#   openssl rand -hex 32
# Rotating it invalidates every session (devices re-register).
AUTH_TOKEN_SECRET=
AUTH_SESSION_TTL_SECONDS=2592000
# A token that expired less than this long ago can still be refreshed.
AUTH_REFRESH_GRACE_SECONDS=2592000
ADMIN_SESSION_TTL_SECONDS=28800

# ─── Rate limiting ──────────────────────────────────────────────────────────────
# Fixed windows in Redis, shared by every instance.
RATE_LIMIT_WINDOW_SECONDS=60
# Coarse per-IP ceiling for every route. Generous: mobile carriers put many users behind one IP.
RATE_LIMIT_IP_MAX=600
# Per IP: register-device, refresh, logout, deletion-job status.
RATE_LIMIT_AUTH_MAX=20
# Per authenticated user, all routes.
RATE_LIMIT_USER_MAX=120
# Per authenticated user, POST /v1/commands.
RATE_LIMIT_COMMANDS_MAX=30

# ─── Idempotency ────────────────────────────────────────────────────────────────
# How long a completed command response is replayable. Short on purpose: responses can contain
# dictated text in the action plan.
IDEMPOTENCY_TTL_SECONDS=300
# How long a running request holds its key.
IDEMPOTENCY_LOCK_SECONDS=30
# How long a duplicate waits for the original's result before answering 409.
IDEMPOTENCY_WAIT_MS=15000

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated browser origins (the admin portal). The mobile app sends no Origin and is
# unaffected. Unset in development = localhost:3000, 3001, 4321. [prod] must be set; empty means
# no browser origin is allowed. "*" is refused.
CORS_ORIGINS=http://localhost:3001

# ─── Request bodies ─────────────────────────────────────────────────────────────
# Every JSON route except commands.
JSON_BODY_LIMIT_BYTES=16384
# POST /v1/commands: 15 s of 16 kHz PCM16 is 480 KB, ~640 KB as base64, plus the screen context.
COMMAND_BODY_LIMIT_BYTES=1048576

# ─── Billing ────────────────────────────────────────────────────────────────────
# disabled: commands are not gated (no payment provider is integrated yet).
# enforced: commands need an active or trial subscription; unknown state is refused.
# [prod] must be set explicitly.
BILLING_MODE=disabled
# Only "none" exists. See src/modules/billing/payment-provider.ts for the integration point.
BILLING_PROVIDER=none
BILLING_CHECK_TIMEOUT_MS=500

# ─── Storage ────────────────────────────────────────────────────────────────────
# none:  no object store; nothing can be written, so deletion has nothing to remove.
# local: files under STORAGE_LOCAL_DIR (development only; not shared between instances).
# [prod] must be set explicitly.
STORAGE_DRIVER=none
STORAGE_LOCAL_DIR=

# ─── Background worker ──────────────────────────────────────────────────────────
# Runs deletion jobs and the telemetry flush inside each API process. Set false when running
# `npm run start:worker` separately.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=5000
# After this many failed attempts a deletion job is marked failed and an alert is logged.
DELETION_JOB_MAX_ATTEMPTS=25
# Cap on buffered telemetry events in Redis; the oldest are dropped beyond it.
TELEMETRY_BUFFER_MAX=10000
