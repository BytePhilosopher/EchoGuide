---
const options = [
	{ value: 'dark', label: 'Dark' },
	{ value: 'light', label: 'Light' },
	{ value: 'auto', label: 'System' },
] as const;
---

<starlight-theme-select>
	<div class="theme-toggle" role="radiogroup" aria-label="Colour theme">
		{options.map((option) => (
			<button
				type="button"
				role="radio"
				value={option.value}
				aria-checked={option.value === 'auto' ? 'true' : 'false'}
				tabindex={option.value === 'auto' ? 0 : -1}
				title={option.label}
			>
				<span class="sr-only">{option.label}</span>
				{option.value === 'dark' && (
					<svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
					</svg>
				)}
				{option.value === 'light' && (
					<svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
					</svg>
				)}
				{option.value === 'auto' && (
					<svg viewBox="0 0 24 24" aria-hidden="true" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="4" width="18" height="12" rx="2" />
						<path d="M2 20h20" />
					</svg>
				)}
			</button>
		))}
	</div>
</starlight-theme-select>

<script>
	type Theme = 'auto' | 'dark' | 'light';

	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

	const loadTheme = (): Theme =>
		parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

	function storeTheme(theme: Theme): void {
		if (typeof localStorage === 'undefined') return;
		localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
	}

	const preferredColorScheme = (): Theme =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	function paint(theme: Theme): void {
		document.querySelectorAll<HTMLButtonElement>('.theme-toggle [role="radio"]').forEach((button) => {
			const on = button.value === theme;
			button.setAttribute('aria-checked', String(on));
			button.tabIndex = on ? 0 : -1;
		});
	}

	function onThemeChange(theme: Theme): void {
		document.documentElement.dataset.theme = theme === 'auto' ? preferredColorScheme() : theme;
		storeTheme(theme);
		paint(theme);
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') onThemeChange('auto');
	});

	class StarlightThemeSelect extends HTMLElement {
		connectedCallback() {
			onThemeChange(loadTheme());

			this.addEventListener('click', (event) => {
				const target = event.target as HTMLElement | null;
				const button = target?.closest<HTMLButtonElement>('[role="radio"]');
				if (button) onThemeChange(parseTheme(button.value));
			});

			this.addEventListener('keydown', (event) => {
				const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
				if (!step) return;
				const buttons = [...this.querySelectorAll<HTMLButtonElement>('[role="radio"]')];
				const index = buttons.findIndex((b) => b === document.activeElement);
				if (index < 0) return;
				event.preventDefault();
				const next = buttons[(index + step + buttons.length) % buttons.length];
				onThemeChange(parseTheme(next.value));
				next.focus();
			});
		}
	}

	if (!customElements.get('starlight-theme-select')) {
		customElements.define('starlight-theme-select', StarlightThemeSelect);
	}
</script>
