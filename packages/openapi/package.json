{
  "name": "@echoguide/openapi",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "generate": "openapi-ts && openapi-typescript openapi.yaml -o src/generated/types.gen.ts",
    "generate:kotlin": "openapi-generator-cli generate --generator-key kotlin",
    "build": "npm run lint && npm run generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@redocly/cli": "^2.54.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.4.5"
  }
}
